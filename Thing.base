summaries:
  Unique: values.unique().length
  Sum: values.sum().round(2)
  Since: |-
    today()
    -values.earliest()
  Loss/gain: |+
    [

    values.reduce(

    if(
    value < 0,
    [acc[0]+1, acc[1]]
    ,if(
    value > 0,
    [acc[0], acc[1]+1]
    )
    )

    ,
    [0,0]

    )

    ].map(

    "↓"+value[0]+"/↑"+value[1]

    )[0]




  Average: values.mean().round(2)
filters:
  and:
    - or:
        - formula.FilterThing == true
        - and:
            - |-
              this.file
              .properties["Query"]
            - |-
              list(
              Collections
              ).contains(
              formula.AutofillCollection
              )
            - |-
              list(
              file.properties[
              this.file
              .properties["Query"]
              ]
              ).contains(
              this.file
              .properties["Collections"]
              )
            - formula.FilterThing == true
        - and:
            - |-
              this.file
              .properties["Query"]
              .isEmpty()
            - |-
              list(
              Collections
              ).contains(
              formula.AutofillCollection
              )
            - formula.FilterThing == true
        - |-
          if(
          formula.£DebugOptions
          .contains(
          "ExtraDebugResults"
          )
          ,

          file == formula.¥XenocrystConfig

          )
    - formula.FilterAdditional == true
    - file.ext.containsAny("md", "canvas")
formulas:
  Thumbnail: |-
    [0].map([

    file
    .properties[formula._tmb]

    ]).map([

    if(
    value[0].isType("Link")
    ,

    image(value[0])

    ,
    value[0]
    )

    ])[0]
  Note: link(file, "See note")
  Open: |-
    if(
    !formula.$that_opn
    .isEmpty()
    ,

    link(
    list(formula.$that_opn)[0],
    "🚀" + file.basename
    )

    ,if(
    !formula.$that_xtr
    .isEmpty()
    ,

    link(
    list(formula.$that_xtr)[0],
    "🌐" + file.basename
    )

    ))
  FilterAdditional: |-
    !(

    [[
    this.file
    .properties["Filter"][0]
    ]].map([
    if(
    value[0] == "Manual",
    this.file
    .properties["Filter"]
    ,
    this.file
    .properties["Collections"]
    )
    ]).map([
    if(
    value[0]
    .contains("Hidden"),
    (0).isTruthy()
    ,Privacy
    .containsAny("Hidden")
    )
    ])[0][0]

    ||

    (0)
    )
  Random: random()
  FilterThing: |-
    formula.€FilterTypeFolders

    &&

    if(
    formula.$this_qry
    .isEmpty()
    ,

    formula.€FilterReverseLink

    ,
    formula.€FilterCrossmatch
    )
  Age: |
    
    [[

    [[
    this.file
    .properties["Reference"],
    Origin
    ]].map(

    if(
    value[0]>value[1],
    [value[0],value[1],""]
    ,if(
    value[1]>value[0],
    [value[1],value[0],"- "]
    ,if(
    value[0]==value[1]
    && value[0] != null,
    [null,null,"Today!"]
    )))

    )[0]


    ]].map([ value[0],

    [
    duration(
    (value[0][0]
    -value[0][1])
    .years.floor()+"y"
    )
    ]

    ]).map([ value[0],

    value[1]
    +
    [
    duration(
    (value[0][0]-
    (value[0][1]
    +value[1][0])
    ).months.floor()+"M"
    )
    ]

    ]).map([ value[0],

    value[1]
    +
    [
    duration(
    (value[0][0]-
    (value[0][1]
    +value[1][0]
    +value[1][1])
    ).days.floor()+"d"
    )
    ]

    ]).map(

    value[0][2]
    +

    if(
    ![
    value[0][0].isType("date"),
    value[0][1].isType("date")
    ].contains(false),


    [
    if(
    value[1][0].years!=0,
    value[1][0].years+" years"
    )
    ,
    if(
    value[1][1].months!=0,
    value[1][1].months+" months"
    )
    ,
    if(
    value[1][2].days!=0,
    value[1][2].days+" days"
    )
    ].filter(
    value!=null
    ).join(", ")

    )

    )[0]
  Backlinks: |-
    file.backlinks
    .filter(
    value.asFile()
    .properties["Discusses"]
    .contains(
    file.name
    )
    ||
    value.asFile()
    .properties["Collections"]
    .contains(
    file.name
    )
    )
    .length
  Relevance: |+
    (


    ( 1 + 
    if(QuickResume,0.5,0) +
    if(Time,Time,0)
    /
    (if(Time,Time.abs(),0) +30)
    )

    *

    ( 1 +
    if(Money,Money.abs(),0)
    /
    (if(Money,Money.abs(),0) +20)
    )

    *

    ( 
    formula.Backlinks
    /
    (formula.Backlinks.abs() +10)
    )

    )

  AutofillCollection: |-
    if(
    this.file
    .properties["Query"]
    .isEmpty(),
    link(this.file.basename)
    .toString()

    ,if(
    this.file
    .properties["Query"],
    list(
    this.file
    .properties["Filter"]
    )[0]

    ))
  DateMain: |-
    ["COMMENT: Picks one of the dates among the filled out date properties by order of relevance / priority. That is to say, from most relevant to least relevant: Expiry > Origin > Engaged > Concluded.",


    if(
    !file
    .properties[formula.Xxpr]
    .isEmpty()
    ,

    file.properties[formula.Xxpr]

    ,if(
    !file
    .properties[formula.Xori]
    .isEmpty()
    ,

    file.properties[formula.Xori]

    ,if(
    !file
    .properties[formula.Xeng]
    .isEmpty()
    ,

    file.properties[formula.Xeng]

    ,if(
    !file
    .properties[formula.Xdng]
    .isEmpty()
    ,

    file.properties[formula.Xdng]

    ))))
    .format("YYYY-MM-DD")


    ,"END COMMENT"][1]
  DateRelative: |-
    ["Comment: anniversaries for entities are treated like other upcoming events, and relative date counts down to the next anniversary. However, anniversaries for non-entities are only shown on the very day of the anniversary, so instead of a useless countdown, the relative date instead shows the age of the thing.",


    [

    formula.Variables

    ].map(

    date(
    if(
    file
    .properties[value[0][0]]
    .contains(
    link(value[1][2][0])
    ), 
    formula.DateMain,
    formula.DateMain
    )
    )
    - today()


    )[0]

    ][1]
  DateAnniversaries: |-
    if(
    "Comment: if main date is already in the past, replace with anniversary date if possible.",

    [

    formula.Variables

    ].map(

    if(
    date(formula.DateMain)
    < today()
    &&
    !file
    .properties[value[0][5]]
    .isEmpty(),

    [
    file
    .properties[value[0][5]]
    ].map(
    today().year
    + value.format("-MM-DD")
    )[0]

    ,formula.DateMain
    )

    )[0]

    )
  CSVAliases: aliases.join(", ")
  YearlyCost: |-
    if(
    Expiry.isEmpty()
    && !Recurrence.isEmpty(),
    Money * (12/Recurrence)
    ,0
    )
  TotalPaid: |-
    
    if(
    Recurrence.isEmpty(),
    Money,

    [

    (
    (today()-Engaged)
    .months
    -
    if(
    Expiry,
    (today()-date(Expiry+"1d"))
    .months
    ,0
    )
    ).floor()

    ].map(

    (value 
    - (value % Recurrence)
    ) / Recurrence

    ).map(

    Money * (1 + value)

    )[0]

    ).round(2)
  £DebugOptions: |-
    list(
    formula.¥DebugFile
    .properties
    .values()[0]
    )
  £PropertyNames: |-
    formula.¥XenocrystConfig
    .properties
    .keys()
  ¥XenocrystConfig: file("Xenocryst config v3")
  _col: formula.£PropertyNames[0]
  _qry: formula.£PropertyNames[1]
  _dsc: formula.£PropertyNames[9]
  _eng: formula.£PropertyNames[3]
  _tmb: formula.£PropertyNames[13]
  _xpr: formula.£PropertyNames[6]
  _ori: formula.£PropertyNames[5]
  _dng: formula.£PropertyNames[4]
  _flt: formula.£PropertyNames[2]
  _dir: formula.£PropertyNames[16]
  _shl: formula.£PropertyNames[8]
  £UnitTests: |-
    if(
    formula.£UTPropertyNames != true
    ,

    formula.£UTPropertyNames

    ,
    true
    )
  £UTPropertyNames: |-
    !formula.£DebugOptions
    .contains(
    "EnforceDefaultPropertyNames"
    )

    ||

    if(
    formula._col != "Collections"
    ,

    "_col != Collections"

    ,if(
    formula._dsc != "Discusses"
    ,

    "_dsc != Discusses"

    ,if(
    formula._eng != "Engaged"
    ,

    "_eng != Engaged"

    ,if(
    formula._dng != "Disengaged"
    ,

    "_dng != Disengaged"

    ,if(
    formula._ori != "Origin"
    ,

    "_ori != Origin"

    ,if(
    formula._xpr != "Expiry"
    ,

    "_xpr != Expiry"

    ,if(
    formula._shl != "Shelved"
    ,

    "_shl != Shelved"

    ,if(
    formula._tmb != "Thumbnail"
    ,

    "_tmb != Thumbnail"

    ,if(
    formula._xtr != "External"
    ,

    "_xtr != External"

    ,if(
    formula._opn != "Shortcuts"
    ,

    "_opn != Shortcuts"

    ,
    true
    ))))))))))
  $$TypeFolders: |-
    if(
    !formula.$this_dir
    .isEmpty()
    ,

    formula.$this_dir
    .map(
    [formula.£TypeFoldersRoot,
    value]
    .join("/")
    )

    )
  £TypeFoldersRoot: |-
    formula.¥XenocrystConfig
    .properties[formula._dir]
    [0]
  €FilterTypeFolders: |-
    if(
    !formula.$$TypeFolders
    .isEmpty()
    &&
    formula.$$TypeFolders
    .map(
    file.inFolder(value)
    ).contains(true)
    ,

    true

    ,if(
    file
    .inFolder(
    formula.£TypeFoldersRoot
    )
    ,

    false

    ,
    true
    ))
  £SpecialFiles: |-
    formula.¥XenocrystConfig
    .properties[formula._col]
  ¥IndexFile: formula.£SpecialFiles[1]
  ¥TodayFile: formula.£SpecialFiles[2]
  ¥YearsFile: formula.£SpecialFiles[0]
  $this_col: |-
    [0].map([

    this.file
    .properties[formula._col]

    ]).map([

    if(
    value[0] == ["true"], 

    [true]

    ,if(
    value[0] == ["false"], 

    [false]

    ,
    value[0]
    ))

    ])[0][0]
  $that_col: |-
    file
    .properties[formula._col]
  $this_flt: |-
    [0].map([

    this.file
    .properties[formula._flt]

    ]).map([

    if(
    value[0] == ["true"], 

    [true]

    ,if(
    value[0] == ["false"], 

    [false]

    ,
    value[0]
    ))

    ])[0][0]
  $this_qry: |-
    this.file
    .properties[formula._qry]
  £ManualKeyword: |-
    formula.¥XenocrystConfig
    .properties[formula._flt]
    [0]
  $that_qry$$: |-
    file
    .properties[
    formula.$this_qry
    ]
  $this_dir: |-
    if(
    formula.$this_qry
    .isEmpty()
    ,

    list(
    this.file
    .properties[formula._dir]
    )

    ,
    list(
    formula.$this_flt
    ).map(
    file(value)
    .properties[formula._dir]
    )
    )
  £SpecialCollections: |-
    formula.¥XenocrystConfig
    .properties[formula._flt]
    .filter(
    value
    != formula.£ManualKeyword
    )
  ¥EntitiesCollection: |-
    formula.£SpecialCollections
    [0]
  ¥DebugFile: |-
    file(
    formula.£SpecialFiles[3]
    )
  €FilterReverseLink: |-
    list(
    formula.$that_col
    ).contains(
    link(this.file.basename)
    .toString()
    )
  €FilterCrossmatch: |-
    [0].map([

    ["SECTION: Crossmatch or Manual",
    if("skip" && false, 
    value[0]
    , 

    if(
    formula.$this_flt[0]
    == formula.£ManualKeyword
    ,

    [
    [],
    [
    formula.$this_flt
    .filter(!(index==0)),
    formula.$this_qry
    ]
    ]

    , 
     
    [
    [
    formula.$this_col,
    formula.$that_qry$$
    ],
    [
    formula.$this_flt,
    formula.$that_col
    ]
    ]
    )

    ),"END SECTION"][1]

    ]).map([

    ["SECTION: create Crossmatch matrices, i.e. this_prop * that_prop",
    if("skip" && false,
    "Hello"
    ,

    value[0].map(

    list(value[0]).reduce(
    [
    acc[0] + [ [value, acc[1]] ],
    acc[1]
    ],

    [
    [],
    value[1]
    ]

    )[0]

    )

    ),"END SECTION"][1]

    ]).map([

    ["SECTION: Contains operations",
    if("skip" && false, 
    value[0]
    , 

    value[0].map(
    value.map(
    value[1] != null
    &&
    value[1].contains(value[0])
    )
    )

    ),"END SECTION"][1]

    ]).map([

    ["SECTION: AND/OR matching mode",
    if("skip" && false, 
    value[0]
    , 

    if("OR" && false,
    list(value[0][0].flat())
    .contains(true)
    ,if("AND" && true,
    !list(value[0][0].flat())
    .contains(false)
    ))
    && 
    if(
    value[0][1] == null,
    true,
    list(value[0][1].flat())
    .contains(true)
    )

    ),"END SECTION"][1]

    ])[0][0]
  _xtr: formula.£PropertyNames[14]
  _opn: formula.£PropertyNames[15]
  $that_opn: |-
    file
    .properties[formula._opn]
  $that_xtr: |-
    file
    .properties[formula._xtr]
  ¥FolderTemplates: |-
    file("✍️Moment")
    .folder
properties:
  note.Attraction:
    displayName: 📊
  note.Favourite:
    displayName: ⭐
  formula.Thumbnail:
    displayName: 🖼️
  note.Serial:
    displayName: 🔢
  note.QuickResume:
    displayName: 🧲
  formula.Backlinks:
    displayName: 🔗
  formula.YearlyCost:
    displayName: YearlyCost
  note.Jitter:
    displayName: j
  note.Pressure:
    displayName: P
  note.Progression:
    displayName: p
  note.Detail:
    displayName: d
views:
  - type: table
    name: Table (reorderable)
    order:
      - formula.Thumbnail
      - file.name
      - aliases
    sort:
      - property: Sequence
        direction: ASC
      - property: Query
        direction: ASC
    separator: ", "
    markers: number
    nestedProperties: false
    columnSize:
      formula.Thumbnail: 32
      file.name: 329
      note.Collections: 488
      note.aliases: 573
  - type: table
    name: Table (ranked)
    groupBy:
      property: Attraction
      direction: DESC
    order:
      - formula.Backlinks
      - QuickResume
      - formula.Thumbnail
      - file.name
      - aliases
    sort:
      - property: formula.Relevance
        direction: DESC
    separator: ", "
    markers: number
    nestedProperties: false
    columnSize:
      formula.Backlinks: 2
      note.QuickResume: 20
      formula.Thumbnail: 32
      file.name: 329
      note.aliases: 573
  - type: table
    name: ---------- Versatile ----------
  - type: list
    name: List (reorderable)
    order:
      - Serial
      - file.name
      - Specifications
      - formula.CSVAliases
    sort:
      - property: Serial
        direction: ASC
    indentProperties: false
  - type: list
    name: List (by date)
    order:
      - file.name
      - formula.MainDate
    sort:
      - property: Engaged
        direction: DESC
  - type: list
    name: List (ranked)
    groupBy:
      property: Attraction
      direction: DESC
    order:
      - file.name
      - formula.Backlinks
    sort:
      - property: formula.Relevance
        direction: DESC
      - property: QuickResume
        direction: DESC
      - property: Attraction
        direction: ASC
    separator: ", "
    markers: bullet
    nestedProperties: false
    columnSize:
      file.name: 624
    cardSize: 340
  - type: cards
    name: Tile, textless (by date)
    order: []
    sort:
      - property: formula.DateMain
        direction: DESC
      - property: Ideated
        direction: DESC
      - property: file.ctime
        direction: DESC
    image: formula.Thumbnail
    cardSize: 160
    imageFit: contain
  - type: cards
    name: Tile, textless (ranked)
    order: []
    sort:
      - property: formula.Relevance
        direction: DESC
    image: formula.Thumbnail
    cardSize: 160
    imageFit: contain
  - type: cards
    name: Tile (ranked)
    order:
      - file.name
    sort:
      - property: formula.Relevance
        direction: DESC
    image: formula.Thumbnail
    cardSize: 160
    imageFit: contain
  - type: cards
    name: Tile, launcher (ranked)
    order:
      - file.name
      - formula.Open
    sort:
      - property: formula.Relevance
        direction: DESC
    columnSize:
      note.Favourite: 32
      note.Attraction: 8
      formula.Thumbnail: 70
      file.name: 206
    image: note.Thumbnail
    cardSize: 110
    imageFit: contain
    imageAspectRatio: 0.9
  - type: cards
    name: Tile, launcher (categorized)
    groupBy:
      property: Collections
      direction: ASC
    order:
      - file.name
      - formula.Open
    imageFit: contain
    image: note.Thumbnail
    cardSize: 130
  - type: cards
    name: Posters (special sorting)
    groupBy:
      property: Structure
      direction: ASC
    order:
      - file.name
      - formula.XCdir
      - formula.Xdir
      - formula.XFfolder
      - formula.XTdir
    sort:
      - property: formula.Relevance
        direction: DESC
      - property: Quest
        direction: DESC
      - property: formula.DateMain
        direction: DESC
    image: note.Thumbnail
    imageFit: contain
    imageAspectRatio: 1.5
    cardSize: 120
  - type: cards
    name: Posters, date (by date)
    order:
      - file.name
      - Origin
    sort:
      - property: Origin
        direction: DESC
    columnSize:
      note.Favourite: 32
      note.Attraction: 8
      formula.Thumbnail: 70
      file.name: 206
    image: note.Thumbnail
    cardSize: 160
    imageFit: contain
    imageAspectRatio: 1.35
  - type: cards
    name: Posters, authors, launcher (ranked)
    groupBy:
      property: Attraction
      direction: ASC
    order:
      - file.name
      - Contributors
      - formula.Open
    sort:
      - property: formula.Relevance
        direction: DESC
    columnSize:
      note.Favourite: 32
      note.Attraction: 8
      formula.Thumbnail: 70
      file.name: 206
    image: note.Thumbnail
    cardSize: 200
    imageFit: contain
    imageAspectRatio: 1.35
  - type: cards
    name: Banners, textless (by date)
    order: []
    sort:
      - property: formula.DateMain
        direction: DESC
    image: note.Thumbnail
    imageAspectRatio: 0.5
    imageFit: contain
    cardSize: 150
  - type: cards
    name: Banners, date (by date)
    order:
      - file.name
      - Origin
    sort:
      - property: formula.DateMain
        direction: DESC
    image: formula.Thumbnail
    imageAspectRatio: 0.5
    imageFit: contain
    cardSize: 150
  - type: cards
    name: Mixed format (ranked)
    order:
      - file.name
    sort:
      - property: formula.Relevance
        direction: DESC
      - property: QuickResume
        direction: DESC
      - property: formula.Random
        direction: ASC
    limit: 12
    image: note.Thumbnail
    imageAspectRatio: 0.85
    cardSize: 140
    imageFit: contain
  - type: cards
    name: Title only grid (by name)
    groupBy:
      property: Attraction
      direction: DESC
    order:
      - file.name
    sort: []
    separator: ", "
    markers: number
    nestedProperties: false
    columnSize:
      note.Attraction: 4
      note.Favourite: 9
      file.name: 206
      note.aliases: 618
    cardSize: 160
  - type: table
    name: ---------- Specific ----------
  - type: table
    name: Entities
    order:
      - QuickResume
      - formula.Thumbnail
      - file.name
      - Markers
      - External
      - Origin
      - Privacy
      - formula.Backlinks
      - Attraction
      - formula.$$TypeFolders
      - formula.FilterThing
      - formula.€FilterTypeFolders
    sort:
      - property: formula.Relevance
        direction: DESC
      - property: file.name
        direction: ASC
    summaries:
      Privacy: Empty
      Focus: Empty
      Markers: Empty
      Origin: Average
      formula.Thumbnail: Empty
      file.name: Average
    columnSize:
      formula.Thumbnail: -15
      file.name: 206
      note.External: 126
      formula.Backlinks: 48
      note.Attraction: -36
      formula.$$TypeFolders: 264
  - type: table
    name: Transactions
    order:
      - formula.Thumbnail
      - formula.YearlyCost
      - formula.TotalPaid
      - file.name
      - Money
      - Recurrence
      - Engaged
      - Expiry
      - Recipient
      - Platform
      - Markers
    sort:
      - property: formula.YearlyCost
        direction: ASC
      - property: Engaged
        direction: DESC
    summaries:
      formula.YearlyCost: Sum
      formula.TotalPaid: Sum
      Engaged: Since
      Money: Loss/gain
    columnSize:
      formula.Thumbnail: 32
      formula.YearlyCost: 120
      formula.TotalPaid: 99
      file.name: 222
      note.Money: 76
      note.Recurrence: 72
  - type: table
    name: Media (by date)
    order:
      - formula.Thumbnail
      - file.name
      - Origin
      - Markers
    sort:
      - property: Origin
        direction: DESC
      - property: formula.Relevance
        direction: DESC
      - property: QuickResume
        direction: DESC
      - property: Quest
        direction: DESC
    separator: ", "
    markers: number
    nestedProperties: false
    columnSize:
      formula.Thumbnail: 57
      file.name: 432
  - type: table
    name: Media (ranked)
    groupBy:
      property: Attraction
      direction: DESC
    order:
      - formula.Thumbnail
      - file.name
      - Markers
      - Platform
      - Origin
      - Quest
    sort:
      - property: formula.Relevance
        direction: DESC
      - property: QuickResume
        direction: DESC
      - property: Quest
        direction: DESC
      - property: Origin
