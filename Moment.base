filters:
  and:
    - file.ext.containsAny("md", "canvas")
    - Reality != "Fictional"
    - or:
        - not:
            - |-
              file.path.startsWith(
              formula.¥FolderConfig
              )
            - |-
              file.path.startsWith(
              formula.¥FolderTemplates
              )
        - |-
          if(
          formula.£DebugOptions
          .contains(
          "ExtraDebugResults"
          )
          ,

          file == formula.¥XenocrystConfig

          )
formulas:
  FilterUpcoming: |-
    ["COMMENT: Returns true for things that have any of their dates happening in the future. For Origin and Expiry, also returns true if on the same day, while for Engaged and Concluded it doesn't, since otherwise the table would get flooded with today's events every single time and become useless.",

    ( (0)
    || 
    today() <= file
    .properties[formula._xpr]
    || 
    today() <= file
    .properties[formula._ori]
    || 
    today() < file
    .properties[formula._eng]
    ||
    if(
    date(formula.DateMain)
    < today()
    &&
    !file
    .properties[formula._ori]
    .isEmpty()
    ,

    if(
    file
    .properties[formula._col]
    .contains(
    formula.¥EntitiesCollection
    )
    ,

    today() 
    <= formula.DateAnniversaries

    ,
    today()
    == formula.DateAnniversaries
    )

    )
    )

    &&

    !( (0)
    || 
    file
    .properties[formula._dng]
    < today()
    )

    ,"END COMMENT"][1]
  Thumbnail: |-
    if(
    file
    .properties[formula._tmb]
    .isType("Link")
    ,

    image(
    file
    .properties[formula._tmb]
    )

    ,
    file
    .properties[formula._tmb]
    )
  DateMain: |-
    ["SECTION: Picks one of the dates among the filled out date properties by order of relevance / priority. That is to say, from most relevant to least relevant: Expiry > Origin > Engaged > Concluded.",

    [0].map([

    if(
    !file
    .properties[formula._xpr]
    .isEmpty()
    ,

    file
    .properties[formula._xpr]

    ,if(
    !file
    .properties[formula._ori]
    .isEmpty()
    ,

    file
    .properties[formula._ori]

    ,if(
    !file
    .properties[formula._eng]
    .isEmpty()
    ,

    file
    .properties[formula._eng]

    ,if(
    !file
    .properties[formula._dng]
    .isEmpty()
    ,

    file
    .properties[formula._dng]

    ))))

    ]).map([

    date(value[0])
    .format("YYYY-MM-DD")

    ])[0][0]

    ,"END SECTION"][1]
  DateRelative: |-
    ["SECTION: anniversaries for entities are treated like other upcoming events, and relative date counts down to the next anniversary. However, anniversaries for non-entities are only shown on the very day of the anniversary, so instead of a useless countdown, the relative date instead shows the age of the thing.",

    [0].map([

    if(
    formula.$that_col
    .contains(
    formula.¥EntitiesCollection
    )
    ,
     
    formula.DateAnniversaries

    ,
    formula.DateMain
    )

    ]).map([

    date(value[0]) - today()

    ]).map([

    if(
    value[0].toString() 
    == "a few seconds"
    ,

    "TODAY!"

    ,
    value[0]
    )

    ])[0][0]

    ,"END SECTION"][1]
  DateAnniversaries: |-
    ["SECTION: if main date is already in the past, replace with anniversary date if possible.",

    [0].map([

    if(
    date(formula.DateMain)
    < today()
    &&
    !file
    .properties[formula._ori]
    .isEmpty()
    ,

    [
    file
    .properties[formula._ori]
    ].map(
    today().year
    + value.format("-MM-DD")
    )[0]

    ,
    formula.DateMain
    )

    ])[0][0]

    ,"END SECTION"][1]
  ContainedDates: |-
    ["COMMENT: too lazy to fix rn, removed variables date capture and drag along in the map chain. Value access needs to be replaced with direct formula calls, or bumped down from [1] to [0] for the data slot",

    if(
    formula.$that_tdate_type
    .isEmpty()
    ,

    null

    ,
    [0].map([ "dud",

    if(
    /^(Day|Week|Month)$/
    .matches(
    formula.$that_tdate_type)
    ,

    null

    ,if(
    /^(Year)$/
    .matches(
    formula.$that_tdate_type)
    ,

    file.basename

    ))

    ]).map([ "dud",

    if(
    value[1] == null,
    if(
    /^(Day|Week)$/
    .matches(value[0][1][1]),
    null
    ,if(
    /^(Month)$/
    .matches(value[0][1][1]),
    file.basename
    ))
    , 
    ["01","02","03","04",
     "05","06","07","08",
     "09","10","11","12"]
    .reduce(
    [acc[0]+
     
    [acc[1]+"-"+value]

    ,acc[1]]
    ,[[], value[1]]
    )[0]

    )

    ]).map([ value[0],

    if(
    value[1] == null,
    if(
    /^(Day)$/
    .matches(value[0][1][1]),
    null
    ,if(
    /^(Week)$/
    .matches(value[0][1][1]),
    file.basename
    ))
    ,
    list(value[1]).flat()
    .map(
    date(value+"-01")
    ).map(
    [value,value,value,value,
     value,value,value,value]
    .map(
    [
    value,
    value
    - (value.format("e")+"d")
    + (index+"w")
    + "3d"
    ]
    ).filter(
    date(value[0])
    .format("YYYY-MM")
    == date(value[1])
    .format("YYYY-MM")
    ).map(
    date(value[1])
    .format("YYYY-WW")
    .replace("-", "-W")
    )
    )

    )

    ]).map([ value[0],

    if(
    value[1] == null,
    if(
    /^(Day)$/
    .matches(value[0][1][1]),
    file.basename
    )
    ,
    list(value[1]).flat()
    .map(
    [
    date(value.slice(0,4)+"-01-01")
    ].map(
    [
    value,
    value - (value.format("e")+"d")
    ]
    ).map(
    if(
    value[1].format("gggg") 
    == value[0].format("YYYY"),
    value[1],
    value[1]+"1w"
    )
    )[0]
    +
    (
    (number(value.slice(6,8))-1)
    +"w")

    ).map(

    [value,value,value,value,
     value,value,value]
    .map(
    value + (index+"d")
    )
    )
    )

    ])[0][1]

    )

    ,"END COMMENT"][1]
  Checkbox: |-
    !
    [0].map([

    if( 
    formula.ContainedDates
    .isEmpty()
    ,

    file.asLink()

    ,
    formula.£Index
    .filter(
    list(formula.ContainedDates)
    .flat().containsAny(
    value.asFile()
    .properties[formula._eng]
    )
    && 
    !value.asFile()
    .properties[formula._eng]
    .isEmpty()
    )
    )

    ]).map([

    list(value[0]).map(
    !value.asFile()
    .properties[formula._shl]
    .isEmpty()
    )

    ]).map([

    !value[0].contains(false)

    ])[0][0]
  SpannedToday: |
    formula.$this_tdate_type
    == "Day"
    &&
    file
    .properties[formula._eng] 
    <= formula.$this_tdate_date
    && 
    file
    .properties[formula._dng] 
    >= formula.$this_tdate_date
  SmartLink: |-
    if(
    formula.SpannedToday
    ,

    link(
    "[["
    + file.basename 
    + "#" 
    + this.file.basename
    + "]]"
    )

    ,
    file
    )
  FilterRecent: |-
    [

    formula.Variables

    ].map(

    file
    .properties[value[0][5]] 
    <= today()
    ||
    file
    .properties[value[0][3]] 
    <= today()

    )[0]
  Backlinks: |
    
    file.backlinks
    .filter(
    value.asFile()
    .properties[
    formula.Variables[0][9]
    ]
    .contains(
    file.name
    )
    ||
    value.asFile()
    .properties[
    formula.Variables[0][0]
    ]
    .contains(
    file.name
    )
    )
    .length
  Relevance: |+
    (


    ( 1 + 
    if(QuickResume,0.5,0) +
    if(Time,Time,0)
    /
    (if(Time,Time.abs(),0) +30)
    )

    *

    ( 1 +
    if(Money,Money.abs(),0)
    /
    (if(Money,Money.abs(),0) +20)
    )

    *

    ( 
    formula.Backlinks
    /
    (formula.Backlinks.abs() +10)
    )

    )

  FilterHeatmap: |-
    [

    formula.VariablesDate

    ].map(

    value[1][2].isEmpty()

    )[0]
  £PropertyNames: |-
    formula.¥XenocrystConfig
    .properties
    .keys()
  ¥XenocrystConfig: file("Xenocryst config v3")
  _ori: formula.£PropertyNames[5]
  £UTPropertyNames: |-
    !formula.£DebugOptions
    .contains(
    "EnforceDefaultPropertyNames"
    )

    ||

    if(
    formula._col != "Collections"
    ,

    "_col != Collections"

    ,if(
    formula._dsc != "Discusses"
    ,

    "_dsc != Discusses"

    ,if(
    formula._eng != "Engaged"
    ,

    "_eng != Engaged"

    ,if(
    formula._dng != "Disengaged"
    ,

    "_dng != Disengaged"

    ,if(
    formula._ori != "Origin"
    ,

    "_ori != Origin"

    ,if(
    formula._xpr != "Expiry"
    ,

    "_xpr != Expiry"

    ,if(
    formula._shl != "Shelved"
    ,

    "_shl != Shelved"

    ,if(
    formula._tmb != "Thumbnail"
    ,

    "_tmb != Thumbnail"

    ,if(
    formula._xtr != "External"
    ,

    "_xtr != External"

    ,if(
    formula._opn != "Shortcuts"
    ,

    "_opn != Shortcuts"

    ,
    true
    ))))))))))
  _eng: formula.£PropertyNames[3]
  _dng: formula.£PropertyNames[4]
  _xpr: formula.£PropertyNames[6]
  £SpecialCollections: |-
    formula.¥XenocrystConfig
    .properties[formula._flt]
    .filter(
    value
    != formula.£ManualKeyword
    )
  ¥EntitiesCollection: |-
    formula.£SpecialCollections
    [0]
  $that_col: |-
    file
    .properties[formula._col]
  _col: formula.£PropertyNames[0]
  _flt: formula.£PropertyNames[2]
  £TitleDateParsing: |-
    [
    this.file.basename,
    file.basename
    ]
    .map(

    [[

    value

    ]].map( list(value) + [

    ["SECTION: Figure out with Regex if the title of the note represents a date of some type, and figure out which type exactly, among day, month, year and week.",

    if( 
    /^\d{4}-\d{2}-\d{2}$/
    .matches(value[0])
    , 

    "Day"

    ,if( 
    /^\d{4}-\d{2}$/
    .matches(value[0])
    , 

    "Month"

    ,if( 
    /^\d{4}$/
    .matches(value[0])
    ,

    "Year"

    ,if( 
    /^\d{4}-W\d{2}$/ .matches(value[0])
    , 

    "Week"

    ,
    ""
    ))))

    ,"END SECTION"][1]

    ]).map( value + [

    ["SECTION: Depending on previously figured out date type, generate an actual date() object, e.g. transforming the string '2026' into the actual date 2026-01-01. The logic for weeks is massive because the first week of the year doesn't start at the same time every year.",

    if( 
    value[1] == "Day"
    ,

    date(value[0])

    ,if( 
    value[1] == "Month"
    ,

    date(value[0]+"-01")

    ,if( 
    value[1] == "Year"
    ,

    date(value[0]+"-01-01")

    ,if( 
    value[1] == "Week"
    ,

    [
    date(
    value[0].slice(0,4)+"-01-01"
    )
    ].map(
    [
    value,
    value - (value.format("e")+"d")
    ]
    ).map(
    if(
    value[1].format("gggg") 
    == value[0].format("YYYY"),
    value[1],
    value[1] + "1w"
    )
    )[0]
    +
    (
    (
    number(value[0].slice(6,8))
    - 1
    )
    +"w"
    )

    ,
    ""
    ))))

    ,"END SECTION"][1]

    ])[0]

    )
  ¥FolderConfig: |-
    formula.¥XenocrystConfig
    .folder
  ¥FolderTemplates: |-
    file("✍️Moment")
    .folder
  £DebugOptions: |-
    list(
    formula.¥DebugFile
    .properties
    .values()[0]
    )
  ¥DebugFile: |-
    file(
    formula.£SpecialFiles[3]
    )
  £ManualKeyword: |-
    formula.¥XenocrystConfig
    .properties[formula._flt]
    [0]
  _tmb: formula.£PropertyNames[13]
  €€FilterMoments: |-
    file
    .properties[formula._dsc]
    .contains(this)

    ||

    (
    formula.$this_tdate_type
    == "Day"
    &&
    if(
    !file
    .properties[formula._dng]
    .isEmpty()
    ,

    file 
    .properties[formula._eng] 
    == date(this.file.basename)

    ,
    formula.SpannedToday
    )
    )

    ||

    (
    formula.$this_tdate_type 
    == "Week"
    &&
    formula.$that_tdate_type 
    == "Day"
    && 
    formula.$this_tdate_date
    ==
    formula.$that_tdate_date
    - (formula.$that_tdate_date
    .format("e")+"d")
    )

    ||

    (
    formula.$this_tdate_type 
    == "Month" 
    && 
    formula.$that_tdate_type 
    == "Week"
    &&
    formula.$this_tdate_date
    .format("YYYY-MM")
    == 
    date(
    formula.$that_tdate_date+"3d").format("YYYY-MM")
    )

    ||

    (
    formula.$this_tdate_type 
    == "Year"
    &&
    formula.$that_tdate_type 
    == "Month"
    &&
    formula.$this_tdate_date
    .format("YYYY")
    == 
    formula.$that_tdate_date
    .format("YYYY")
    )

    ||

    (
    this.file 
    == file(formula.¥YearsFile)
    && 
    formula.$that_tdate_type 
    == "Year"
    )
  $this_tdate_date: |-
    formula.£TitleDateParsing
    [0][2]
  $that_tdate_date: |-
    formula.£TitleDateParsing
    [1][2]
  $this_tdate_type: |-
    formula.£TitleDateParsing
    [0][1]
  $that_tdate_type: |-
    formula.£TitleDateParsing
    [1][1]
  ¥YearsFile: formula.£SpecialFiles[0]
  £AutofillDate: |-
    if(
    formula.$this_tdate_type 
    == "Day"
    ,

    formula.$that_tdate_date

    )
  £AutofillDiscusses: |-
    if(
    date(
    formula.$this_tdate_date
    ).isEmpty()
    ,

    link(this.file.basename)

    )
  _dsc: formula.£PropertyNames[9]
  ¥IndexFile: formula.£SpecialFiles[1]
  _shl: formula.£PropertyNames[8]
  £Index: |-
    formula.¥IndexFile
    .asFile().links
  £SpecialFiles: |-
    formula.¥XenocrystConfig
    .properties[formula._col]
properties:
  note.Money:
    displayName: 💵
  formula.Checkbox:
    displayName: 🤔
  formula.Thumbnail:
    displayName: 🖼️
  note.Attraction:
    displayName: 📊
  formula.Backlinks:
    displayName: 🔗
  formula.Relevance:
    displayName: Relevance
  note.QuickResume:
    displayName: 🧲
  formula.DateRelative:
    displayName: ⌛
views:
  - type: table
    name: 🔛 Notes on this day or about this topic
    filters:
      or:
        - and:
            - Engaged == formula.£AutofillDate
            - "!Engaged.isEmpty()"
        - and:
            - |-
              Discusses.contains(
              formula.£AutofillDiscusses
              )
            - (!Discusses.contains(null))
        - formula.€€FilterMoments == true
        - formula.SpannedToday == true
    order:
      - formula.Thumbnail
      - formula.Checkbox
      - formula.SmartLink
      - Engaged
      - Discusses
    sort:
      - property: formula.SpannedToday
        direction: DESC
      - property: formula.VariablesDate
        direction: ASC
      - property: Engaged
        direction: ASC
      - property: file.ctime
        direction: ASC
    columnSize:
      formula.Thumbnail: 51
      formula.Checkbox: -18
      formula.SmartLink: 416
      note.Engaged: 133
      formula.XenoVar: 1093
    dateProperty: note.Engaged
    startDate: 2025-10-01
    endDate: 2026-05-01
    trackProperty: formula.Checkbox
  - type: table
    name: 🔜 Upcoming + anniversaries
    filters:
      and:
        - Shelved.isEmpty()
        - formula.FilterUpcoming == true
    order:
      - formula.Thumbnail
      - file.name
      - formula.DateRelative
      - formula.DateMain
      - Money
      - Reality
      - formula.FilterUpcoming
    sort:
      - property: formula.DateAnniversaries
        direction: ASC
      - property: formula.DateMain
        direction: ASC
    limit: 5
    rowHeight: medium
    columnSize:
      formula.Thumbnail: 51
      file.name: 179
      formula.DateRelative: 64
      note.Money: 69
      note.Reality: 149
  - type: table
    name: 🔙 Recent overview
    filters:
      and:
        - formula.FilterUpcoming == true
    groupBy:
      property: formula.DateMain
      direction: DESC
    order:
      - formula.Checkbox
      - formula.Thumbnail
      - file.name
      - Attraction
      - Reality
      - formula.DateMain
    sort:
      - property: formula.DateMain
        direction: DESC
      - property: file.ctime
        direction: DESC
    limit: 30
    columnSize:
      formula.Checkbox: -116
      formula.Thumbnail: 51
      file.name: 487
      note.Attraction: 47
  - type: table
    name: 🔝 Heatmap
    filters:
      and:
        - not:
            - file.hasProperty("Discusses")
            - Quest == "Done"
            - formula.Backlinks.isEmpty()
        - file.hasProperty("Collections")
    groupBy:
      property: Attraction
      direction: DESC
    order:
      - formula.Thumbnail
      - file.name
      - QuickResume
      - formula.Backlinks
      - Time
      - Money
      - Quest
      - Attraction
    sort:
      - property: formula.Relevance
        direction: DESC
    limit: 90
    columnSize:
      formula.Thumbnail: 51
      file.name: 310
      note.Time: 60
      note.Money: 69
      note.Attraction: 47
  - type: table
    name: 🔚 Missed notes
    filters:
      or:
        - and:
            - |-
              if(
              formula.VariablesDate[0][1] 
              == "Day",
              file.ctime
              .format("YYYY-MM-DD")
              == this.file.basename
              ,
              true
              )
            - or:
                - |-
                  /^[Uu][Nn][Tt][Ii][Tt][Ll][Ee][Dd]/
                  .matches(file.basename)
                - and:
                    - and:
                        - or:
                            - Discusses.isEmpty()
                            - Engaged.isEmpty()
                        - and:
                            - Collections.isEmpty()
                    - not:
                        - formula.ContainedDates
    order:
      - file.name
      - file.ctime
    sort:
      - property: file.ctime
        direction: DESC
    limit: 20
    columnSize:
      file.name: 360
